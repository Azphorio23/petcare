# Opción A · PostgreSQL instalado en tu PC
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=tu_contraseña
PGDATABASE=petcare

# Opción B · Base en la nube (Supabase): quita el # de la línea de abajo y pega la
# cadena del "Session pooler" (Supabase → Connect). Si está activa, se ignora la opción A.
# DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_CONTRASEÑA@aws-0-REGION.pooler.supabase.com:5432/postgres
